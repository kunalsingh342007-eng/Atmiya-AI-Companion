# Gemini API key used only by the server-side Express/API routes.
# Copy this file to .env locally and replace the placeholder with a real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional standalone-server port for local `npm run dev` or `npm start`.
PORT="3000"

# Optional comma-separated origins for split-origin CORS (leave unset for same-origin Vercel/Express).
# ALLOWED_ORIGIN="https://your-frontend.example.com"

# Optional client API base URL when frontend and backend are hosted on separate origins.
# VITE_API_BASE_URL="https://your-api.example.com"

